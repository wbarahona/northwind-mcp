{
  "name": "@northwind/e2e-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Test helper: a seeded in-memory MongoDB plus the built API as a child process, for end-to-end suites",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@northwind/api": "workspace:*",
    "@northwind/seed": "workspace:*",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.3"
  },
  "devDependencies": {
    "@northwind/eslint-config": "workspace:*",
    "@northwind/tsconfig": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3"
  }
}
