{
  "extends": "@northwind/tsconfig/library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "jest"],
    // scripts/ runs directly under Node's type stripping, which needs explicit .ts imports.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "scripts"]
}
