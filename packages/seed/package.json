{
  "name": "@northwind/seed",
  "version": "0.0.0",
  "private": true,
  "description": "Classic Northwind data: vendored source, transform, date shift and idempotent loader",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/jest/bin/jest.js",
    "seed": "node dist/cli.js",
    "convert": "node scripts/convert-instnwnd.mts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 60000
  },
  "dependencies": {
    "@northwind/db": "workspace:*",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^9.11.3"
  },
  "devDependencies": {
    "@northwind/eslint-config": "workspace:*",
    "@northwind/tsconfig": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  }
}
