# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# MongoDB from docker-compose (single-node replica set)
MONGO_URI=mongodb://localhost:27017/northwind?replicaSet=rs0

# API
PORT=3000
# Interface for pnpm dev (default 127.0.0.1: this machine only)
# HOST=127.0.0.1
# Comma-separated list of accepted x-api-key values
API_KEYS=dev-key-change-me

# Seed: fixed anchor for the date shift (optional; defaults to today)
# SEED_ANCHOR_DATE=2026-10-15

# MCP server (apps/mcp). Hosts like Claude Code pass these themselves; `pnpm --filter
# @northwind/mcp inspect` reads them from this file.
NORTHWIND_API_URL=http://localhost:3000
# Must be one of API_KEYS above.
NORTHWIND_API_KEY=dev-key-change-me
# false = read-only: the order write tools are not registered.
NORTHWIND_MCP_WRITES=true

# Docker stack (pnpm stack:up). The api container uses API_KEYS above and connects to the
# Compose Mongo itself; MONGO_URI and PORT above are for pnpm dev only.
# Host port for the stack's API (default 3000, the same as pnpm dev: run one or the other).
# API_PORT=3000
# Host port for the Compose Mongo (default 27017; the smoke test uses its own).
# MONGO_PORT=27017
# Database name on the Compose Mongo (default northwind).
# MONGO_DB=northwind
# LOG_LEVEL=info
# Base images; point them at another registry if Docker Hub rate-limits (HTTP 429), e.g.
# public.ecr.aws/docker/library/node:24-alpine and public.ecr.aws/docker/library/mongo:8
# NODE_IMAGE=node:24-alpine
# MONGO_IMAGE=mongo:8

# Chat agent (pnpm dev, or the stack's agent container on :5173).
# Where the model runs: docker-model-runner (the default), ollama, or openai-compatible (any
# server with the OpenAI chat API: llama.cpp, LM Studio, vLLM, a cloud API).
# LLM_PROVIDER=docker-model-runner
# The stack's Compose files: the base, plus the model server's (':' separates them; ';' on
# Windows). Without it, the stack's agent uses Docker Model Runner inside Docker Desktop.
# COMPOSE_FILE=docker-compose.yml:compose.model-runner.yml
# COMPOSE_FILE=docker-compose.yml:compose.ollama.yml
# COMPOSE_FILE=docker-compose.yml:compose.ollama.yml:compose.ollama-nvidia.yml
# The model. Default: Qwen3 4B (~2.5 GB; about 7.5-8 of 9 benchmark questions right), named
# hf.co/Qwen/Qwen3-4B-GGUF:Q4_K_M on Docker Model Runner and qwen3:4b on Ollama. Qwen3 8B
# (~5 GB; 9 of 9, but ~1.6x slower) for machines with 24 GB or more:
# LLM_MODEL=hf.co/Qwen/Qwen3-8B-GGUF:Q4_K_M
# LLM_MODEL=qwen3:8b
# What the agent does for this model family: qwen3 (its /no_think switch and text tool calls)
# or generic (any model that calls tools the standard way). Default: from the model's name.
# LLM_PROFILE=
# 1 = the model reasons before answering, for profiles with a switch (qwen3): better
# planning, much slower.
# LLM_THINKING=0
# Sampling temperature (0-2). Unset = the model server's default, which benchmarked
# better than 0.2.
# LLM_TEMPERATURE=
# Where the model server is, for pnpm dev. Defaults: Docker Model Runner on localhost:12434,
# Ollama on localhost:11434; required with openai-compatible.
# LLM_URL=
# The same for the stack's agent, as seen from its container (openai-compatible only; e.g.
# http://host.docker.internal:1234/v1/ for a server on this machine).
# STACK_LLM_URL=
# Bearer token, for servers that need one (cloud APIs).
# LLM_API_KEY=
# Ollama's image and its port on this machine (compose.ollama.yml).
# OLLAMA_IMAGE=ollama/ollama:latest
# OLLAMA_PORT=11434
# Share the stack's chat on the local network: 0.0.0.0 (default 127.0.0.1, this machine only).
# Anyone on the network can then use it: read-only data, but no login.
# AGENT_BIND=127.0.0.1
# AGENT_PORT=5173

